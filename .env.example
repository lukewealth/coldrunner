# ColdRunners Business Intelligence Platform - Environment Configuration

# === AI & LLM ===
GEMINI_API_KEY=""

# === OpenAI-compatible LLM gateway (e.g. FreeLLMAPI) ===
# Keep the API key server-side; never prefix with VITE_.
LLM_PROVIDER="freellmapi"
LLM_BASE_URL="http://localhost:3001/v1"
LLM_API_KEY=""
LLM_DEFAULT_MODEL="auto"
LLM_REQUEST_TIMEOUT_MS="60000"
# Optional authoritative per-model USD pricing; missing rates show cost as unknown.
LLM_PRICING_JSON="{}"
WEB_SEARCH_ENABLED="true"
AGENT_MAX_STEPS="12"
AGENT_MAX_TOOL_CALLS="30"
AGENT_REQUIRE_APPROVAL="true"

# === Google APIs (Compliant) ===
GOOGLE_PLACES_API_KEY=""
GOOGLE_PAGESPEED_API_KEY=""

# === Web Analysis ===
FIRECRAWL_API_KEY="" # Add your own key locally; never commit real credentials

# === Contact Discovery ===
HUNTER_API_KEY=""
APOLLO_API_KEY=""
CLEARBIT_API_KEY=""

# === Server ===
PORT="3000"
NODE_ENV="development"

# === Database ===
DB_PATH="./data/coldrunners.db"

# === Export ===
EXPORT_DIR="./exports"

# === Agent Configuration ===
MAX_CONCURRENT_AGENTS="5"
AGENT_TIMEOUT="30000"
AGENT_RETRY_ATTEMPTS="3"

# === Retry Configuration ===
RETRY_MAX_ATTEMPTS="3"
RETRY_BASE_DELAY_MS="1000"
RETRY_MAX_DELAY_MS="30000"

# === Cache Configuration ===
CACHE_ENABLED="true"
CACHE_TTL_MS="1800000"
CACHE_MAX_ENTRIES="5000"
CACHE_PERSIST="true"
CACHE_PATH="./data/cache.json"

# === App URL ===
APP_URL="MY_APP_URL"

# === Real-Time Search (SearXNG - Free Web Search) ===
# Self-hosted metasearch engine aggregating Google, Bing, DuckDuckGo, Brave, Wikipedia
# Deploy via Docker: docker compose up -d (see free-ai-search repo)
SEARXNG_BASE_URL=""

# === Real-Time Search (SurfSense - Live Data Connectors) ===
# Open-source research platform with Google Maps, Indeed, Google Search, web crawl
# Deploy via Docker or use cloud: https://surfsense.com
SURFSENSE_API_URL=""
SURFSENSE_API_KEY=""
SURFSENSE_WORKSPACE_ID=""

# === Browser Automation (Browser Use Cloud API) ===
# AI-driven browser automation for web scraping, form filling, data extraction
# Get API key at: https://cloud.browser-use.com
BROWSER_USE_API_KEY=""
BROWSER_USE_API_URL="https://api.browser-use.com/api/v2"
