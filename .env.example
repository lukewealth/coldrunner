# ColdRunners Business Intelligence Platform - Environment Configuration

# === AI & LLM ===
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# === Google APIs (Compliant) ===
GOOGLE_PLACES_API_KEY=""
GOOGLE_PAGESPEED_API_KEY=""

# === Web Analysis ===
FIRECRAWL_API_KEY="fc-c0ac668287bf468bb5e3929316233a26"

# === Contact Discovery ===
HUNTER_API_KEY=""
APOLLO_API_KEY=""
CLEARBIT_API_KEY=""

# === Server ===
PORT="3000"
NODE_ENV="development"

# === Database ===
DB_PATH="./data/coldrunners.db"

# === Export ===
EXPORT_DIR="./exports"

# === Agent Configuration ===
MAX_CONCURRENT_AGENTS="5"
AGENT_TIMEOUT="30000"
AGENT_RETRY_ATTEMPTS="3"

# === Retry Configuration ===
RETRY_MAX_ATTEMPTS="3"
RETRY_BASE_DELAY_MS="1000"
RETRY_MAX_DELAY_MS="30000"

# === Cache Configuration ===
CACHE_ENABLED="true"
CACHE_TTL_MS="1800000"
CACHE_MAX_ENTRIES="5000"
CACHE_PERSIST="true"
CACHE_PATH="./data/cache.json"

# === App URL ===
APP_URL="MY_APP_URL"

# === Real-Time Search (SearXNG - Free Web Search) ===
# Self-hosted metasearch engine aggregating Google, Bing, DuckDuckGo, Brave, Wikipedia
# Deploy via Docker: docker compose up -d (see free-ai-search repo)
